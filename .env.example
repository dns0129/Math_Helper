# 仅填写线上服务的域名，不含路径。生产环境需要 HTTPS。
MATH_PUBLIC_URL=https://math.example.com
MATH_BIND_HOST=0.0.0.0
PORT=8791
# 与同机其他应用隔离时可改为 18791；只在服务器回环地址开放。
MATH_HTTP_BIND_PORT=8791
# owner 的网页访问密码：部署时生成至少 24 个随机字符。
MATH_ACCESS_PASSWORD=
# 网页“连接 DeepSeek”保存配置的位置；请保留数据卷。
DEEPSEEK_CONFIG_FILE=/app/.local/deepseek.json
# 也可通过服务器环境变量配置；不要填写到公开源码中。
# DEEPSEEK_API_KEY=
# 使用 Compose 数据卷时为 persistent；无持久磁盘的平台为 ephemeral。
MATH_AUTH_STORAGE=persistent
MATH_PYTHON=/opt/math-env/bin/python
